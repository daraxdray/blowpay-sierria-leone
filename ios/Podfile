# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# ✅ Keep New Architecture enabled for Reanimated
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

project 'blowpay_mobile.xcodeproj'

platform :ios, '16.0'

prepare_react_native_project!

use_modular_headers!

# ✅ Keep static linkage (fixes modular import issues with Firebase)
use_frameworks! :linkage => :static

target 'blowpay_mobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Copy hermesvm dSYMs into the archive so App Store Connect can symbolicate crashes.
    # The prebuilt Hermes xcframework ships dSYMs alongside each slice.
    main_project = Xcodeproj::Project.open(File.join(__dir__, 'blowpay_mobile.xcodeproj'))
    main_target  = main_project.targets.find { |t| t.name == 'blowpay_mobile' }
    if main_target && main_target.shell_script_build_phases.none? { |p| p.name == '[RN] Copy Hermes dSYM' }
      phase = main_target.new_shell_script_build_phase('[RN] Copy Hermes dSYM')
      phase.shell_script = <<~SHELL
        HERMES_XCFRAMEWORK="${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/universal/hermesvm.xcframework"
        for SLICE in ios-arm64 ios-arm64_x86_64-simulator; do
          DSYM="${HERMES_XCFRAMEWORK}/${SLICE}/hermesvm.framework.dSYM"
          if [ -d "$DSYM" ]; then
            cp -r "$DSYM" "${DWARF_DSYM_FOLDER_PATH}/"
          fi
        done
      SHELL
      main_project.save
    end

    # 🩹 Patch: make all pods modular if possible (helps Firebase + Swift pods)
    # 🩹 Enforce minimum iOS 12 (Xcode 26 requires 12.0–26.2; some pods default to 9.0)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        config.build_settings['DEFINES_MODULE'] = 'YES'
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 12.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
        end
        # Xcode 26+ Apple Clang mis-compiles fmt 11 consteval; -DFMT_USE_CONSTEVAL=0 only works if
        # base.h does not redefine it (we patch that after the loop).
        if target.name == 'fmt'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
          defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
          defs = [defs] unless defs.is_a?(Array)
          defs << 'FMT_USE_CONSTEVAL=0' unless defs.any? { |d| d.to_s.include?('FMT_USE_CONSTEVAL') }
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
        end
      end
    end

    # fmt's base.h redefines FMT_USE_CONSTEVAL after -DFMT_USE_CONSTEVAL=0; wrap auto-detect so the flag sticks.
    fmt_base_h = File.join(__dir__, 'Pods/fmt/include/fmt/base.h')
    if File.exist?(fmt_base_h)
      contents = File.read(fmt_base_h)
      marker = 'FMT_BLOWPAY_WRAP_CONSTEVAL_DETECT'
      unless contents.include?(marker)
        needle = "// Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.\n#if !defined(__cpp_lib_is_constant_evaluated)"
        replacement =
          "// Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.\n" \
          "#ifndef FMT_USE_CONSTEVAL /* #{marker} */\n" \
          "#if !defined(__cpp_lib_is_constant_evaluated)"
        unless contents.include?(needle)
          raise 'fmt base.h changed; update Podfile wrap for consteval block'
        end
        contents = contents.sub(needle, replacement)
        contents = contents.sub(
          "#endif\n#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval",
          "#endif\n#endif /* #{marker} */\n#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
        )
        File.chmod(0o644, fmt_base_h)
        File.write(fmt_base_h, contents)
      end
    end
  end
end
